   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">DESI Year-One Data Slice (annotated)</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A slice of the 3D map of galaxies collected in the first year of the Dark Energy Spectroscopic Instrument (DESI) Survey with annotations identifying key features in the map. Earth is at the tip, with the furthest galaxies plotted at distances of 11 billion light-years. Each point represents one galaxy. This version of the DESI map includes 600,000 galaxies â€” less than 0.1% of the survey's full volume.</rdf:li>
    </rdf:Alt>
   </dc:description>
